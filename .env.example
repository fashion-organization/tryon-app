# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project → Settings → Environment Variables:
# "Preview" and "Development" use the dev Supabase project, "Production" uses the prod project.

# Supabase (Project → Settings → API). The publishable key is safe in the browser;
# row-level security protects the data. Older projects call it the "anon" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security: never prefix with NEXT_PUBLIC_, never send to the browser.
# Older projects call it the "service_role" key. Not needed until account deletion (step 1.11).
SUPABASE_SECRET_KEY=

# Added in later steps:
# NEXT_PUBLIC_SENTRY_DSN=          (step 1.1, once the Sentry project exists)
# NEXT_PUBLIC_POSTHOG_KEY=         (step 1.1, once the PostHog project exists)
# NEXT_PUBLIC_POSTHOG_HOST=
# TRYON_PROVIDER=mock              (step 1.7)
# TRYON_DAILY_FREE_PER_USER=3      (step 1.7)
# TRYON_GLOBAL_DAILY_CAP=          (step 1.7)
# FASHN_API_KEY=                   (step 1.7)
# CRON_SECRET=                     (step 1.7)
