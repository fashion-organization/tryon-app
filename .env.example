# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project → Settings → Environment Variables:
# "Preview" and "Development" use the dev Supabase project, "Production" uses the prod project.

# Supabase (Project → Settings → API). The publishable key is safe in the browser;
# row-level security protects the data. Older projects call it the "anon" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security: never prefix with NEXT_PUBLIC_, never send to the browser.
# Older projects call it the "service_role" key. Not needed until account deletion (step 1.11).
SUPABASE_SECRET_KEY=

# Server only. OpenAI moderation checks uploaded photos (free endpoint). Without it, uploads are
# allowed unchecked outside production and refused in production.
OPENAI_API_KEY=

# Try-on. TRYON_PROVIDER: mock (free, returns your own photo after 5 s), fashn-v1.6 or fashn-max.
# Unset means mock, except on the live site, where try-on stays off until it is set.
TRYON_PROVIDER=mock
# New try-ons per user, and for the whole site, in any 24 hours. Results already made are free and unlimited.
TRYON_DAILY_FREE_PER_USER=3
TRYON_GLOBAL_DAILY_CAP=100
# Server only. From app.fashn.ai → API. Needed only when TRYON_PROVIDER is a fashn one.
FASHN_API_KEY=
# Optional: cents per FASHN credit, for cost records (default 7.5 = $0.075).
# FASHN_CENTS_PER_CREDIT=7.5
# Optional, development only: make every mock try-on fail with this code, e.g. PoseError.
# TRYON_MOCK_FAIL=
# Server only. Any long random string; Vercel Cron sends it to /api/cron/sweep.
CRON_SECRET=

# Added in later steps:
# NEXT_PUBLIC_SENTRY_DSN=          (step 1.1, once the Sentry project exists)
# NEXT_PUBLIC_POSTHOG_KEY=         (step 1.1, once the PostHog project exists)
# NEXT_PUBLIC_POSTHOG_HOST=
